# Copy to .env and fill in. Never commit .env.
ENTERPRISE_AGENTGATEWAY_LICENSE_KEY=
# Optional: only the live "real model" moments use it. Leave empty to run mock-only.
ANTHROPIC_API_KEY=
# Issuer the gateway pins. Must equal the iss claim Keycloak puts in tokens.
KEYCLOAK_ISSUER=http://localhost:8380/realms/si-demo
# Where the gateway fetches signing keys. localhost works: the gateway shares Keycloak's network namespace.
KEYCLOAK_JWKS_URL=http://localhost:8380/realms/si-demo/protocol/openid-connect/certs
# Public URL of the MCP endpoint, advertised in OAuth protected-resource metadata.
# Change to the tunnel's https URL for the Claude.ai connector.
MCP_PUBLIC_URL=http://localhost:4300/mcp
# Encodes MCP session IDs. ./demo.sh up generates one if empty. Keep it out of
# gateway/config.yaml: without it the gateway writes a generated key into that file.
SESSION_KEY=
